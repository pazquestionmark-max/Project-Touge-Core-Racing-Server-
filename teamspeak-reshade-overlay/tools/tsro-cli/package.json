{
  "name": "tsro-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Configuration tooling and protocol test harness for the TeamSpeak ReShade Overlay",
  "type": "module",
  "bin": { "tsro": "./dist/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --ext .ts",
    "start": "node --experimental-strip-types src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
